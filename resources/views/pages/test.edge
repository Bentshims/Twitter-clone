<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <title>
      Tabs 100% Tailwind avec UIkit JS
    </title>
    <script src="https://cdn.tailwindcss.com">
      
    </script>
    <!-- Scripts Uikit ma lib des tab simple -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/uikit@3.16.24/dist/css/uikit.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/uikit@3.16.24/dist/js/uikit.min.js">
      
    </script>
  </head>
  <body class="bg-gray-100 p-6 font-sans">

    <h1 class="text-2xl font-bold mb-6">
      🎯 Onglets avec UIkit + Tailwind Control Total
    </h1>

    <!-- Tabs -->
    <ul id="my-tabs" uk-tab class="flex space-x-4 border-b border-gray-300">
      <li class="group uk-active relative">
        <a
          href="#"
          class="inline-block px-4 py-2 text-gray-600 group-[.uk-active]:text-blue-600 transition"
        >
          Onglet 1
          <div class="hidden group-[.uk-active]:block absolute bottom-0 left-0 right-0 h-1 bg-blue-600">
          </div>
        </a>
      </li>
      <li class="group relative">
        <a
          href="#"
          class="inline-block px-4 py-2 text-gray-600 hover:text-blue-400 group-[.uk-active]:text-blue-600 transition"
        >
          Onglet 2
          <div class="hidden group-[.uk-active]:block absolute bottom-0 left-0 right-0 h-1 bg-blue-600">
          </div>
        </a>
      </li>
      <li class="group relative">
        <a
          href="#"
          class="inline-block px-4 py-2 text-gray-600 hover:text-blue-400 group-[.uk-active]:text-blue-600 transition"
        >
          Onglet 3
          <div class="hidden group-[.uk-active]:block absolute bottom-0 left-0 right-0 h-1 bg-blue-600">
          </div>
        </a>
      </li>
    </ul>

    <!-- Contenus -->
    <ul class="uk-switcher mt-4">
      <li>
        <div class="bg-white p-4 rounded shadow">
          Contenu du premier onglet
        </div>
      </li>
      <li>
        <div class="bg-white p-4 rounded shadow">
          Contenu du deuxième onglet
        </div>
      </li>
      <li>
        <div class="bg-white p-4 rounded shadow">
          Contenu du troisième onglet
        </div>
      </li>
    </ul>
    (099) 268-2760
  </body>
</html>
