<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>
      Compte X.com - Inscription / Connexion
    </title>
    <script src="https://cdn.tailwindcss.com">
      
    </script>
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
      rel="stylesheet"
    />

    <style>
      .tab-panel {
        transition: opacity 0.3s ease-in-out;
      }
      
      .tab-panel.hidden {
        opacity: 0;
        pointer-events: none;
        position: absolute;
        inset: 0;
      }
      
      .tab-panel.visible {
        opacity: 1;
        pointer-events: auto;
        position: relative;
      }
    </style>

    {{--  le jquery pour le bon fonctionnement de parsley  --}}
    <script src="https://code.jquery.com/jquery-3.7.1.min.js">
      
    </script>

    {{--  les cdn parsleyjs  --}}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/parsleyjs/src/parsley.css" />
    <script src="https://cdn.jsdelivr.net/npm/parsleyjs">
      
    </script>

    {{--  file pond  --}}
    <link href="https://unpkg.com/filepond@^4/dist/filepond.css" rel="stylesheet" />
    <script defer src="https://unpkg.com/filepond@^4/dist/filepond.js">
      
    </script>
    <link
      href="https://unpkg.com/filepond-plugin-image-preview/dist/filepond-plugin-image-preview.css"
      rel="stylesheet"
    />
    <script defer src="https://unpkg.com/filepond-plugin-image-preview/dist/filepond-plugin-image-preview.js">
      
    </script>

    <script defer src="https://unpkg.com/password-toggle@latest/dist/password-toggle.min.js"></script>

  </head>
  <body class="bg-black text-white flex items-center justify-center min-h-screen p-4">
    <div class="relative p-8 rounded-lg shadow-lg w-full max-w-md min-h-[620px] relative">

      <div class="flex justify-center mb-8">
        <svg class="w-12 h-auto" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
          <!--!Font Awesome Free 6.7.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2025 Fonticons, Inc.-->          <path
            d="M389.2 48h70.6L305.6 224.2 487 464H345L233.7 318.6 106.5 464H35.8L200.7 275.5 26.8 48H172.4L272.9 180.9 389.2 48zM364.4 421.8h39.1L151.1 88h-42L364.4 421.8z"
          />
        </svg>
      </div>

      <nav
        class="flex border-b border-gray-700 mb-6"
        role="tablist"
        aria-label="Formulaires Inscription et Connexion"
      >
        <button
          id="tab-signup"
          aria-selected="true"
          aria-controls="panel-signup"
          role="tab"
          class="flex-1 py-2 text-center font-semibold text-blue-400 border-b-2 border-blue-400 focus:outline-none"
        >
          Inscription
      </button>
        <button
          id="tab-login"
          aria-selected="false"
          aria-controls="panel-login"
          role="tab"
          class="flex-1 py-2 text-center font-semibold text-gray-400 border-b-2 border-transparent hover:text-blue-400 focus:outline-none"
        >
          Connexion
      </button>
      </nav>

      <section
        id="panel-signup"
        role="tabpanel"
        tabindex="0"
        aria-labelledby="tab-signup"
        class="tab-panel visible"
      >
        <form
          data-parsley-validate
          id="signupForm"
          action="/signupUser"
          method="POST"
          enctype="multipart/form-data"
          class="space-y-4"
        >
          {{ csrfField() }}

        <input
            data-parsley-required-message="Ce champs est obligatoire"
            data-parsley-trigger="keyup change"
            data-parsley-minLength="3"
            data-parsley-minLength-message="Ce champs doit avoir au moins 3 caracteres"
            type="text"
            name="fullName"
            placeholder="Nom et Prénom"
            required
            autocomplete="given-name"
            class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-md text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
          <input
            data-parsley-required-message="Ce champs est obligatoire"
            data-parsley-trigger="keyup change"
            data-parsley-pattern="^@.*_$"
            data-parsley-pattern-message="Le nom utilisateur doit commencer par @ et finir par _"
            type="text"
            name="userName"
            placeholder="Nom utilisateur"
            required
            autocomplete="family-name"
            class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-md text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
          <input
            data-parsley-required-message="Ce champs est obligatoire"
            data-parsley-trigger="keyup change"
            data-parsley-type-message="Veuiller entrer un email valide"
            data-parsley-type="email"
            type="email"
            name="email"
            placeholder="Adresse email"
            required
            autocomplete="email"
            class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-md text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
          <input
            data-parsley-required-message="Ce champs est obligatoire"
            data-parsley-trigger="keyup change"
            data-parsley-minLength="8"
            data-parsley-minLength-message="Le mot de passe doit avoir au moins 8 caracteres"
            type="password"
            name="password"
            placeholder="********"
            required
            minlength="8"
            autocomplete="new-password"
            class="password w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-md text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
          <input
            data-parsley-required-message="Ce champs est obligatoire"
            data-parsley-trigger="keyup change"
            type="date"
            name="birthDate"
            required
            max="2010-12-31"
            class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-md text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
          <textarea
            data-parsley-trigger="keyup change"
            data-parsley-minLength-message="le bio doit avoir au moins 10 caracteres"
            data-parsley-minLength="10"
            data-parsley-maxLength="255"
            data-parsley-maxLength-message="vous avez depasser la limite de 255 caracteres"
            name="bio"
            rows="3"
            maxlength="255"
            placeholder="Bio"
            class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-md text-white placeholder-gray-400 resize-none focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          ></textarea>
          <input id="profileLink" type="file" name="profileLink" accept="image/*" class="text-gray-300" />
          <button
            type="submit"
            class="w-full bg-blue-600 hover:bg-blue-700 py-2 rounded-md font-semibold transition-colors"
          >S’inscrire</button>
        </form>
      </section>

      <section
        id="panel-login"
        role="tabpanel"
        tabindex="0"
        aria-labelledby="tab-login"
        class="tab-panel hidden"
        aria-hidden="true"
      >
        <form data-parsley-validate action="/loginUser" method="POST" class="space-y-4">
          {{ csrfField() }}

        <input
            data-parsley-required-message="Ce champs est obligatiore"
            data-parsley-trigger="keyup change"
            data-parsley-type-message="Veuillez entrer un email valide"
            data-parsley-type="email"
            type="email"
            name="email"
            placeholder="Adresse email"
            required
            autocomplete="email"
            class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-md text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
          <input
            data-parsley-required-message="Ce champs est obligatiore"
            data-parsley-trigger="keyup change"
            data-parsley-minLength-message="Le mot de passe doit avoir au moins 8 caracteres"
            data-parsley-type="password"
            type="password"
            name="password"
            placeholder="Mot de passe"
            required
            autocomplete="current-password"
            class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-md text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
          <button
            type="submit"
            class="w-full bg-blue-600 hover:bg-blue-700 py-2 rounded-md font-semibold transition-colors"
          >Se connecter</button>
        </form>
      </section>
    </div>

    <script defer>
      document.addEventListener("DOMContentLoaded", () => {
        const tabs = document.querySelectorAll('[role="tab"]');
        const tabPanels = document.querySelectorAll(".tab-panel");
        tabs.forEach(tab => {
          tab.addEventListener("click", () => {
            // Désactivation onglets
            tabs.forEach(t => {
              t.setAttribute("aria-selected", "false");
              t.classList.remove("text-blue-400", "border-blue-400");
              t.classList.add("text-gray-400", "border-transparent");
            });
            tabPanels.forEach(panel => {
              panel.classList.remove("visible");
              panel.classList.add("hidden");
              panel.setAttribute("aria-hidden", "true");
            });
            tab.setAttribute("aria-selected", "true");
            tab.classList.add("text-blue-400", "border-blue-400");
            tab.classList.remove("text-gray-400", "border-transparent");
            const panelId = tab.getAttribute("aria-controls");
            const panel = document.getElementById(panelId);
            panel.classList.remove("hidden");
            panel.classList.add("visible");
            panel.removeAttribute("aria-hidden");
            panel.focus();
          });
        });
        window.addEventListener("DOMContentLoaded", () => {
          // rendre disponible quand le DOM est charger
          FilePond.registerPlugin(FilePondPluginImagePreview); // activation du plugin en quelque sorte
          const image = document.querySelector("#profileLink"); // recupereration du champs input file
          FilePond.create(image, {
            instantUpload: false,
            storeAsFile: true
          }); // utlisation de FilePond sur le champ et lui rapeler de guarder le fichier jusqu’a ce que le formulaire soit soumit
        });
        new PasswordToggle({
          selector: ".password",
          eyeClass: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye-fill" viewBox="0 0 16 16">
                              <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0"/>
                              <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8m8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7"/>
                              </svg>`,
          eyeSlashClass: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye-slash-fill" viewBox="0 0 16 16">
                                    <path d="m10.79 12.912-1.614-1.615a3.5 3.5 0 0 1-4.474-4.474l-2.06-2.06C.938 6.278 0 8 0 8s3 5.5 8 5.5a7 7 0 0 0 2.79-.588M5.21 3.088A7 7 0 0 1 8 2.5c5 0 8 5.5 8 5.5s-.939 1.721-2.641 3.238l-2.062-2.062a3.5 3.5 0 0 0-4.474-4.474z"/>
                                    <path d="M5.525 7.646a2.5 2.5 0 0 0 2.829 2.829zm4.95.708-2.829-2.83a2.5 2.5 0 0 1 2.829 2.829zm3.171 6-12-12 .708-.708 12 12z"/>
                                    </svg> `
        });
      });
    </script>
  </body>
</html>

