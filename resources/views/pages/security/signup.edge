<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Inscription - X.com</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/parsleyjs/src/parsley.css" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/parsleyjs"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@latest/font/bootstrap-icons.min.css" />
  </head>

  <body class="bg-black text-white md:flex flex-col items-center justify-center min-h-screen p-4 ">
    <div class="my-8 space-y-4">
      <div class="flex justify-center">
        <svg class="w-12 h-auto text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" fill="white">
          <path d="M389.2 48h70.6L305.6 224.2 487 464H345L233.7 318.6 106.5 464H35.8L200.7 275.5 26.8 48H172.4L272.9 180.9 389.2 48zM364.4 421.8h39.1L151.1 88h-42L364.4 421.8z" />
        </svg>
      </div>

      <h1 class="text-center text-xl font-semibold text-white">Bienvenue sur X. Rejoignez la conversation !</h1>

    </div>
    <div class="bg-[#000] border border-[#2f3336] p-8 rounded-3xl shadow-lg w-full max-w-md space-y-6">
      
    
      <form action="/signupUser" method="POST" enctype="multipart/form-data" data-parsley-validate class="space-y-6">
        {{ csrfField() }}

        <div class="flex flex-col items-center space-y-2">
          <label for="profileLink" class="cursor-pointer group relative">
            <img
              id="avatarPreview"
              src="https://res.cloudinary.com/drsd8adkq/image/upload/v1753633785/ab06735f-3278-44e6-9877-b7a4f0c2c631.png"
              alt="Photo de profil"
              class="w-24 h-24 rounded-full object-cover border border-[#2f3336] transition duration-300 group-hover:opacity-80"
            />
            <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition duration-200 bg-black/50 rounded-full">
              <i class="bi bi-plus-circle text-blue-400 text-xl font-bold"></i>
            </div>
          </label>
          <input type="file" id="profileLink" name="profileLink" accept="image/*" class="hidden" />
        </div>

        <input type="text" name="fullName" required placeholder="Nom et prénom"
          data-parsley-minlength="3"
          class="w-full px-4 py-3 bg-[#16181c] border border-[#2f3336] rounded-xl text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-[#1d9bf0]" />

        <input type="text" name="userName" required placeholder="Nom utilisateur (@..._)"
          data-parsley-pattern="^@.*_$"
          class="w-full px-4 py-3 bg-[#16181c] border border-[#2f3336] rounded-xl text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-[#1d9bf0]" />

        <input type="email" name="email" required placeholder="Adresse email"
          class="w-full px-4 py-3 bg-[#16181c] border border-[#2f3336] rounded-xl text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-[#1d9bf0]" />

        <div class="relative w-full">
          <input type="password" name="password" required minlength="8" placeholder="Mot de passe"
            class="password w-full px-4 py-3 bg-[#16181c] border border-[#2f3336] rounded-xl text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-[#1d9bf0]" />
          <button type="button" class="togglePassword absolute right-4 top-3">
            <svg id="eyeIcon" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-400" fill="none"
              viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M2.458 12C3.732 7.943 7.523 5 12 5s8.268 2.943 9.542 7c-1.274 4.057-5.065 7-9.542 7s-8.268-2.943-9.542-7z" />
            </svg>
          </button>
        </div>

        <input type="date" name="birthDate" required max="2010-12-31"
          class="w-full px-4 py-3 bg-[#16181c] border border-[#2f3336] rounded-xl text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-[#1d9bf0]" />

        <textarea name="bio" placeholder="Bio (255 caractères max)" rows="3" maxlength="255"
          class="w-full px-4 py-3 bg-[#16181c] border border-[#2f3336] rounded-2xl text-white placeholder-gray-500 resize-none focus:outline-none focus:ring-2 focus:ring-[#1d9bf0]"></textarea>

        <button type="submit"
          class="w-full bg-[#1d9bf0] hover:bg-[#1a8cd8] py-3 rounded-full font-bold transition duration-200">S'inscrire</button>
      </form>
    </div>

    <script>
      document.querySelector("#profileLink").addEventListener("change", function (e) {
        const file = e.target.files[0];
        if (file) {
          const reader = new FileReader();
          reader.onload = function (event) {
            document.getElementById("avatarPreview").src = event.target.result;
          };
          reader.readAsDataURL(file);
        }
      });

      document.querySelectorAll(".togglePassword").forEach((btn) => {
        const input = btn.previousElementSibling;
        const icon = btn.querySelector("svg");
        btn.addEventListener("click", () => {
          const isVisible = input.type === "text";
          input.type = isVisible ? "password" : "text";
          icon.innerHTML = isVisible
            ? `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
               <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M2.458 12C3.732 7.943 7.523 5 12 5s8.268 2.943 9.542 7c-1.274 4.057-5.065 7-9.542 7s-8.268-2.943-9.542-7z" />`
            : `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.542-7
                     a9.96 9.96 0 012.602-4.263M6.513 6.511A9.953 9.953 0 0112 5c4.478 0
                     8.268 2.943 9.542 7a9.969 9.969 0 01-4.478 5.249M3 3l18 18" />`;
        });
      });
    </script>
  </body>
</html>
