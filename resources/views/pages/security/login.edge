<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Connexion - X.com</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/parsleyjs/src/parsley.css" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/parsleyjs"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@latest/font/bootstrap-icons.min.css" />
  </head>

  <body class="bg-black text-white md:flex flex-col items-center justify-center min-h-screen p-4">
    <div class="my-8 space-y-4">
      <div class="flex justify-center">
        <svg class="w-12 h-auto text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" fill="white">
          <path d="M389.2 48h70.6L305.6 224.2 487 464H345L233.7 318.6 106.5 464H35.8L200.7 275.5 26.8 48H172.4L272.9 180.9 389.2 48zM364.4 421.8h39.1L151.1 88h-42L364.4 421.8z" />
        </svg>
      </div>
      <h1 class="text-center text-xl font-semibold">Heureux de vous revoir !</h1>
    </div>

    <div class="bg-[#000] border border-[#2f3336] p-8 rounded-3xl shadow-lg w-full max-w-md space-y-6">
        <form action="/login" method="POST" data-parsley-validate class="space-y-6">
            {{ csrfField() }}
          
            <input type="email" name="email" required placeholder="Adresse email"
              data-parsley-type-message="Veuillez entrer une adresse email valide."
              class="w-full px-4 py-3 bg-[#16181c] border border-[#2f3336] rounded-xl text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-[#1d9bf0]" />
          
            <div class="relative w-full">
              <input type="password" name="password" required minlength="8" placeholder="Mot de passe"
                data-parsley-minlength-message="Le mot de passe doit contenir au moins 8 caractères."
                class="password w-full px-4 py-3 bg-[#16181c] border border-[#2f3336] rounded-xl text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-[#1d9bf0]" />
              <button type="button" class="togglePassword absolute right-4 top-3">
                <svg id="eyeIcon" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-400" fill="none"
                  viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M2.458 12C3.732 7.943 7.523 5 12 5s8.268 2.943 9.542 7c-1.274 4.057-5.065 7-9.542 7s-8.268-2.943-9.542-7z" />
                </svg>
              </button>
            </div>
          
            <button type="submit"
              class="w-full bg-[#1d9bf0] hover:bg-[#1a8cd8] py-3 rounded-full font-bold transition duration-200">
              Se connecter
            </button>
          
            <p class="text-center text-sm text-gray-400 mt-4">
              Vous n'avez pas de compte ?
              <a href="/signup" class="text-[#1d9bf0] hover:underline">Créer un compte</a>
            </p>
          </form>
          
    </div>

    <script>
      // Toggle mot de passe
      document.querySelectorAll(".togglePassword").forEach((btn) => {
        const input = btn.previousElementSibling;
        const icon = btn.querySelector("svg");
        btn.addEventListener("click", () => {
          const isVisible = input.type === "text";
          input.type = isVisible ? "password" : "text";
          icon.innerHTML = isVisible
            ? `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
               <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M2.458 12C3.732 7.943 7.523 5 12 5s8.268 2.943 9.542 7c-1.274 4.057-5.065 7-9.542 7s-8.268-2.943-9.542-7z" />`
            : `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.542-7
                     a9.96 9.96 0 012.602-4.263M6.513 6.511A9.953 9.953 0 0112 5c4.478 0
                     8.268 2.943 9.542 7a9.969 9.969 0 01-4.478 5.249M3 3l18 18" />`;
        });
      });

      // Parsley config pour marges et style des messages
      window.ParsleyConfig = {
        errorsWrapper: '<div class="text-red-500 text-sm mt-1"></div>',
        errorTemplate: '<div></div>',
        errorClass: 'border-red-500 focus:ring-red-500',
        successClass: 'border-green-500 focus:ring-green-500'
      };
    </script>
  </body>
</html>
