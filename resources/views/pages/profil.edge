    <script>
      function openTable(tabId) {
        document.querySelectorAll(".tab-content").forEach(content => {
          content.classList.add("hidden");
        });
        document.querySelectorAll(".tab-button").forEach(button => {
          button.classList.add('transition','duration-500');
        });
        document.getElementById(tabId).classList.remove("hidden");
        event.currentTarget.classList.add("border-b", "border-gray-700");
        // event.currentTarget.classList.remove("border-b", "border-gray-700");
      }
    </script>

