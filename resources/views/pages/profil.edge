    <div
      id="profileModal"
      class="fixed inset-0 z-50 hidden bg-black bg-opacity-60 flex items-center justify-center"
    >
      <div class="bg-[#15202b] text-white w-full max-w-md rounded-xl shadow-lg p-6 relative">
        <button id="closeModal" class="absolute top-2 right-2 text-gray-400 hover:text-white text-xl">&times;</button>

        <h2 class="text-xl font-bold mb-4">Modifier le profil</h2>

        <form action="/profile/update" method="POST" enctype="multipart/form-data" class="space-y-4" data-parsley-validate>
          <input type="text" name="fullName" placeholder="Nom complet" required
            data-parsley-minlength="3"
            class="w-full px-4 py-2 rounded bg-[#192734] text-white border border-[#2f3336] focus:outline-none" />

          <input type="text" name="userName" placeholder="Nom d'utilisateur" required
            data-parsley-pattern="^@.*_$"
            data-parsley-pattern-message="Le nom d'utilisateur doit commencer par @ et se terminer par _."
            class="w-full px-4 py-2 rounded bg-[#192734] text-white border border-[#2f3336] focus:outline-none" />

          <input type="email" name="email" placeholder="Email" required
            data-parsley-type-message="Veuillez entrer un email valide"
            class="w-full px-4 py-2 rounded bg-[#192734] text-white border border-[#2f3336] focus:outline-none" />

          <textarea name="bio" placeholder="Bio" maxlength="255"
            class="w-full px-4 py-2 rounded bg-[#192734] text-white border border-[#2f3336] focus:outline-none"
          ></textarea>

          <input type="file" name="profilePhoto" accept="image/*"
            class="block w-full text-sm text-gray-300 bg-[#192734] file:bg-[#1d9bf0] file:text-white file:rounded file:px-4 file:py-2 file:border-none file:cursor-pointer" />

          <button type="submit"
            class="w-full bg-[#1d9bf0] hover:bg-[#1a8cd8] py-2 rounded-full font-bold transition duration-200">
            Enregistrer les modifications
          </button>
        </form>
