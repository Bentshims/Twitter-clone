
@layout.app({title:"Home",notifications, user})
  @slot('main')
    <div id="loader-screen" class="fixed inset-0 bg-black/80 backdrop-blur-sm  flex items-center justify-center z-50 w-full">
      <div class="loader-inner ball-clip-rotate">
        <div class=""></div>
      </div>
    </div>

    <div class="w-full hidden" id="myAppContent">
      <section class="">
        <div class="min-h-screen md:border-x border-zinc-700  relative">
          <nav
            class="sticky top-0 flex items-center justify-between px-2 py-4 md:p-4 border-b border-r  border-b-blue-400/50  border-r-zinc-700 z-50 bg-black/70 backdrop-blur-sm"
          >
            <p class="capitalize font-semibold text-xl">
              home
            </p>
            <img src="/public/uploads/logo1.svg" alt="home icon" class="w-6 h-6" />
          </nav>

          <div
            class="user border-b border-zinc-700 flex justify-between px-2 py-4 md:p-4 min-h-36 md:min-h-42 lg:min-h-48 relative"
          >
            <div class="flex  md:space-x-4">
              <div>
                <a href="/profil">
                  @if(user?.profilLink)
                    <img
                      src="{{ user.profilLink }}"
                      alt="profil image"
                      class="w-16 h-16 rounded-full object-cover object-center"
                    />
                  @else
                    <div class="bg-zinc-800 w-16 h-16 text-xl rounded-full flex items-center justify-center font-bold">
                      {{ user.fullName.substring(0, 1).toUpperCase() }}
                    </div>
                  @endif
                  
                </a>
              </div>
              <div class="ml-3 md:ml-0 w-[80%] md:w-auto">
                <form
                  action="/tweet/create"
                  method="POST"
                  class="lg:flex flex-col justify-between"
                  enctype="multipart/form-data"
                >
                  {{ csrfField() }}
                  <fieldset class="w-full">
                    <textarea
                      id="tweetContent"
                      name="content"
                      minlength="10"
                      maxlength="255"
                      oninput="handleInput(this)"
                      class="appearance-none overflow-hidden resize-none w-80 lg:w-128 min-h-28 bg-black outline-none border-none pt-4"
                      placeholder="What's happening ?"
                      required
                    ></textarea>
                  </fieldset>

                  <section class="flex justify-between pt-4">
                    <div class="flex justify-between items-center">
                      <label
                        class="cursor-pointer transition duration-500 ease hover:bg-[#202327] rounded-full w-12 h-12 flex items-center justify-center"
                      >
                        <img src="/public/uploads/image.svg" alt="select image buttom" />
                        <input type="file" name="media" accept="image/*,video/*" class="hidden" onchange="previewImage(event)" />
                      </label>
                      <div
                        class="cursor-pointer transition duration-500 ease hover:bg-[#202327] rounded-full w-12 h-12 flex items-center justify-center"
                      >
                        <img src="/public/uploads/Gif.svg" alt="select GIF buttom" />

                      </div>

                      <div
                        class="cursor-pointer transition duration-500 ease hover:bg-[#202327] rounded-full w-12 h-12 flex items-center justify-center"
                      >
                        <img src="/public/uploads/bar.svg" alt="select image buttom" />

                      </div>

                      <div
                        class="cursor-pointer transition duration-500 ease hover:bg-[#202327] rounded-full w-12 h-12 flex items-center justify-center"
                      >
                        <button type="button" onclick="toggleEmojiPicker()">
                          <img src="/public/uploads/smile.svg" alt="select emoji buttom" />
                        </button>
                      </div>
                      <div
                        class="cursor-pointer transition duration-500 ease hover:bg-[#202327] rounded-full w-12 h-12 flex items-center justify-center"
                      >
                        <img src="/public/uploads/Schedule.svg" alt="/public/uploads/Schedule.svg" />
                      </div>
                    </div>

                    <fieldset class="flex justify-end absolute right-2 bottom-3 md:right-2">
                      <button
                        class="w-full bg-blue-500 px-6 py-3 rounded-full transition duration-300 ease hover:bg-blue-600"
                        type="submit"
                      >
                        tweet
                      </button>
                    </fieldset>
                  </section>

                </form>
              </div>
            </div>
          </div>

          <div class="tweets relative">
            <div>
              @each(tweet in tweets)
                <div class="flex items-start gap-3 p-4 border-b border-gray-700">
                  <a href="/profil/{{ tweet.user.userName }}">
                    @if(!tweet.user?.profilLink)
                      <div class="bg-zinc-800 w-12 h-12 rounded-full flex items-center justify-center font-bold">
                        {{ tweet.user.fullName.substring(0, 1).toUpperCase() }}
                      </div>
                    @else
                      <div
                        class="bg-[url({{ tweet.user.profilLink }})] w-12 h-12 border-gray-700 rounded-full bg-cover bg-center"
                      >
                      </div>
                    @endif
                  </a>
                  <div class="space-y-2 w-full">
                    <div class="flex justify-between items-center">
                      <div class="flex items-center gap-4">
                        <div class="flex items-center gap-2">
                          <p class="capitalize ">
                            {{ tweet.user.fullName }}
                          </p>
                          <img src="/public/uploads/check.svg" alt="" class=" w-4 h-auto" />
                        </div>
                        <p class="text-gray-500">
                          {{ tweet.user.userName }}
                        </p>
                      </div>
                      <p class="text-gray-600">
                        {{ fromNow(tweet.createdAt) }}
                      </p>
                    </div>
                    <div class="space-y-4">
                      <p>
                        {{ tweet.content }}
                      </p>
                      @if(tweet.media)
                        @if(tweet.media && (tweet.media.endsWith('.mp4') || tweet.media.endsWith('.webm') || tweet.media.endsWith('.mov')))
                          <video src="{{ tweet.media }}" muted autoplay class="border border-gray-600 border-2 rounded-xl">
                          </video>
                        @elseif(tweet.media && (tweet.media.endsWith('.png') || tweet.media.endsWith('.jpeg') || tweet.media.endsWith('.jpg')))
                          <img src="{{ tweet.media }}" alt="tweet media" class="border border-gray-600 border-2 rounded-xl" />
                        @end
                      @end
                    </div>
                    <div class="flex justify-between items-center pt-6 mr-14 w-full">
