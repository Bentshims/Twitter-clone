                        <img src="/public/uploads/smile.svg" alt="smile icon">
                      </div>
                      <div class="cursor-pointer">
                        <img src="/public/uploads/Schedule.svg" alt="/public/uploads/Schedule.svg" />
                      </div>
                    </div>


                    <fieldset class="flex justify-end absolute bottom-3 right-6">
                      <button class="w-full bg-blue-500 px-6 py-3 rounded-full transition duration-300 ease hover:bg-blue-600" type="submit">
                        tweet
                      </button>
                    </fieldset>
                  </section>
                


                </form>
              </div>
            </div>
          </div>
