          <div class="tweets relative">
            <div>
              @each(tweet in tweets)
                @if(tweet.isRetweet)
                  <div class="text-sm text-gray-400 flex items-center border-b border-zinc-700 gap-4 p-2 bg-zinc-950">
                    <div class="">
                      <a href="/profil/{{ tweet.user.userName }}">
                        @if(!tweet.retweetUser.profilLink)
                          <div class="bg-zinc-800 w-8 h-8 rounded-full flex items-center justify-center font-bold">
                            {{ tweet.retweetUser.fullName.substring(0, 1).toUpperCase() }}
                          </div>
                        @else
                          <div
                            class="bg-[url({{ tweet.retweetUser.profilLink }})] w-8 h-8 border-gray-700 rounded-full bg-cover bg-center"
                          >
                          </div>
                        @endif
                      </a>
                    </div>
                    <p class="">
                      {{ tweet.retweetUser.userName }} a retweeté
                    </p>
                    <p class="text-gray-500">
                      {{ fromNow(tweet.retweetedAt) }}
                    </p>
                  </div>
                @end
                <div class="flex items-start gap-3 p-2 md:p-4 border-b border-gray-700">
                  <a href="/profil/{{ tweet.user.userName }}">
                    @if(!tweet.user?.profilLink)
                      <div class="bg-zinc-800 w-12 h-12 rounded-full flex items-center justify-center font-bold">
                        {{ tweet.user.fullName.substring(0, 1).toUpperCase() }}
                      </div>
                    @else
                      <div
                        class="bg-[url({{ tweet.user.profilLink }})] w-12 h-12 border-gray-700 rounded-full bg-cover bg-center"
                      >
                      </div>
                    @endif
                  </a>
                  <div class="space-y-2 w-full">
                    <div class="flex justify-between items-center">
                      <div class="flex items-center gap-4">
                        <div class="flex items-center gap-2">
                          <p class="capitalize ">
                            {{ tweet.user.fullName }}
                          </p>
                          <img src="/public/uploads/check.svg" alt="" class=" w-4 h-auto" />
                        </div>
                        <p class="text-gray-500">
                          {{ tweet.user.userName }}
                        </p>
                      </div>
                      <p class="text-gray-600">
                        {{ fromNow(tweet.createdAt) }}
                      </p>
                    </div>
                    <div class="space-y-4">
                      <p>
                        {{ tweet.content }}
                      </p>
                      @if(tweet.media)
                        @if(tweet.media && (tweet.media.endsWith('.mp4') || tweet.media.endsWith('.webm') || tweet.media.endsWith('.mov')))
                          <video src="{{ tweet.media }}" muted autoplay class="border border-gray-600 border-2 rounded-xl">
                          </video>
                        @elseif(tweet.media && (tweet.media.endsWith('.png') || tweet.media.endsWith('.jpeg') || tweet.media.endsWith('.jpg')))
                          <img src="{{ tweet.media }}" alt="tweet media" class="border border-gray-600 border-2 rounded-xl" />
                        @end
                      @end
                    </div>

                    {{--  les actions : comment, retweet, like et l'autre   --}}
                    <div class="flex justify-between items-center pt-6 mr-14 w-full">
                      <div class="flex items-center gap-2">
                        <div class="comment-content transition duration-200 ease">
                          <button
                            type="button"
                            data-micromodal-trigger="modal-comment-{{ tweet.id }}"
                            class="comment-icon transition duration-500 ease rounded-full w-8 h-8 flex items-center justify-center open-comment-modal"
                            data-tweet-id="{{ tweet.id }}"
                          >
                            <i class="far fa-comment text-zinc-600 hover:text-zinc-200"></i>
                          </button>
                        </div>
                        <p class="like-number transition duration-200 ease text-zinc-600">
                          {{ tweet.$extras.comments_count }}
                        </p>
                      </div>

                      <div class="flex items-center gap-2">
                        <div class="retweet-content transition duration-200 ease">
                          <form action="/retweet/{{ tweet.id }}" method="POST">
                            {{ csrfField() }}
                            <button type="submit">
                              @if(tweet.isretweet)
                                <i class="fas fa-retweet text-[#f91880]"></i>
                              @else
                                <div
                                  class="retweet-icon transition duration-500 ease rounded-full w-8 h-8 flex items-center justify-center"
                                >
                                  <i class="fas fa-retweet text-zinc-600 hover:text-zinc-200"></i>
                                </div>
                              @endif
                            </button>
                          </form>
                        </div>
                        <p class="like-number transition duration-200 ease text-zinc-600">
                          {{ tweet.$extras.retweets_count }}
                        </p>
                      </div>

                      <div class="flex items-center gap-2">
                        <div class="likes-content transition duration-200 ease">
                          <form action="/like/{{ tweet.id }}" method="POST">
                            {{ csrfField() }}
                            <button type="submit">
                              @if(tweet.isLike)
                                <i class="bi bi-heart-fill text-[#f91880]"></i>
                              @else
                                <div
                                  class="like-icon transition duration-500 ease rounded-full w-8 h-8 flex items-center justify-center"
                                >
                                  <i class="bi bi-heart text-zinc-600 hover:text-zinc-200"></i>
                                </div>
                              @endif
                            </button>
                          </form>
                        </div>
                        <p class="like-number transition duration-200 ease text-zinc-600">
                          {{ tweet.$extras.likes_count }}
                        </p>
                      </div>
                      <div
                        class="transition duration-400 ease hover:bg-[#1D9BF0]/30 w-8 h-8 flex items-center justify-center rounded-full"
                      >
                        <img src="/public/uploads/doawnload.svg" alt="" />
                      </div>
                    </div>
