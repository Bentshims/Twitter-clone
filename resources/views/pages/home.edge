                </a>
             </div>
              <div>
                <form action="/post" method="post">
                  {{ csrfField() }}
                  <fieldset class="w-full">
                    <textarea name="tweet" class="appearance-none overflow-hidden resize-none w-80 bg-black outline-none border-none pt-4" placeholder="What's happening ?" required></textarea>
                  </fieldset>

                  <section class="flex justify-between pt-4">
                    <div class="flex justify-between items-center gap-4">
                      <div class="cursor-pointer">
                        <img src="/public/uploads/image.svg" alt="image icon">
                      </div>
                      <div class="cursor-pointer">
                        <img src="/public/uploads/Gif.svg" alt="/public/uploads/Schedule.svg" />
                  
                      </div>
                  
                      <div class="cursor-pointer">
                        <img src="/public/uploads/bar.svg" alt="/public/uploads/Schedule.svg" />
                  
                      </div>
                  
