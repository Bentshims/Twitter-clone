@layout.app({title: "notifications", notifications, user }) 
    @slot('main')
        <section class="w-full">
            <div class="relative min-h-screen border-x border-zinc-700">
                <nav class="sticky top-0 flex items-center justify-between px-2 py-4 md:p-4 border-b  border-blue-400/50  z-50 bg-black/70 backdrop-blur-sm">
                  <p class="capitalize font-semibold text-xl">
                    home
                  </p>
                  <img src="/public/uploads/logo1.svg" alt="home icon" class="w-6 h-6" />
                </nav>

                @each(notification in notifications)
                    <div class="border-b border-zinc-700 p-2 pb-4 space-y-4 relative min-h-20">
                        <div class="w-full flex justify-between items-center">
                            <p class="text-zinc-500 text-right text-sm">
                                {{notification.createdAt.hour}} h
                            </p>
                            <div class="text-zinc-600 cursor-pointer">
                                <i class="bi bi-three-dots">
    
                                </i>
                            </div>
                        </div>
                        <p class="text-zinc-200">
                            {{notification.content}}
                        </p>
                        @if(notification.isRead === true) 
                            <p class="border rounded-full bg-blue-400 w-20 h-20">
                                
                            </p>
                        @end
                        
                    </div>
                @end
            </div>
         
        </section>
    @endslot
@end