    </div>
    <script>
      // le loader 
      window.addEventListener("load", () => {
        setTimeout(() => {
          const loader = document.querySelector("#loader-screen");
          const content = document.querySelector("#myAppContent");
          loader.classList.add("hidden");
          content.classList.remove("hidden");
        }, 2000);
      });

      document.addEventListener("DOMContentLoaded", () => {
        const picker = document.getElementById("emojiPicker");
        const textarea = document.getElementById("tweetContent");
        const emojiBtn = document.querySelector('button[onclick="toggleEmojiPicker()"]');
        window.toggleEmojiPicker = () => {
          picker.style.display = picker.style.display === "none" ? "block" : "none";
        };
        if (picker) {
          // Insérer l'emoji dans le textarea
          picker.addEventListener("emoji-click", event => {
            const emoji = event.detail.unicode;
            const start = textarea.selectionStart;
            const end = textarea.selectionEnd;
            const value = textarea.value;
            textarea.value = value.slice(0, start) + emoji + value.slice(end);
            textarea.focus();
            textarea.setSelectionRange(start + emoji.length, start + emoji.length);
          });
        }
        document.addEventListener("click", e => {
          const isClickInside = picker.contains(e.target) || emojiBtn.contains(e.target);
          if (!isClickInside) picker.style.display = "none";
        });
        let currentlyOpenTrash = null;
        document.querySelectorAll(".delete-btn").forEach(btn => {
          btn.addEventListener("click", e => {
            e.stopPropagation();
            const parent = btn.closest(".relative");
            const trash = parent.querySelector(".trash");
            if (currentlyOpenTrash && currentlyOpenTrash !== trash) {
              currentlyOpenTrash.classList.add("hidden");
            }
            trash.classList.toggle("hidden");
            currentlyOpenTrash = trash.classList.contains("hidden") ? null : trash;
          });
        });
        // Si on clique ailleurs on ferme le bouton pour supprime avec la notification
        document.addEventListener("click", () => {
          if (currentlyOpenTrash) {
            currentlyOpenTrash.classList.add("hidden");
            currentlyOpenTrash = null;
          }
        });
        
        // les likes
        document.querySelectorAll(".likes-content").forEach(content => {
          content.addEventListener("mouseover", () => {
            const icon = content.querySelector(".like-icon").classList.add("bg-[#f91880]/20");
            const number = content.nextElementSibling.classList.add("text-[#f91880]");
          });
          content.addEventListener("mouseout", () => {
            const icon = content.querySelector(".like-icon").classList.remove("bg-[#f91880]/20");
            const number = content.nextElementSibling.classList.remove("text-[#f91880]");
          });
        });
        // les retweets
        document.querySelectorAll(".retweet-content").forEach(content => {
          content.addEventListener("mouseover", () => {
            const icon = content.querySelector(".retweet-icon").classList.add("bg-[#00BA7C]/30");
            const number = content.nextElementSibling.classList.add("text-[#00BA7C]");
          });
          content.addEventListener("mouseout", () => {
            const icon = content.querySelector(".retweet-icon").classList.remove("bg-[#00BA7C]/30");
            const number = content.nextElementSibling.classList.remove("text-[#00BA7C]");
          });
        });
        // les commentares
        document.querySelectorAll(".comment-content").forEach(content => {
          content.addEventListener("mouseover", () => {
            const icon = content.querySelector(".comment-icon").classList.add("bg-[#1D9BF0]/30");
            const number = content.nextElementSibling.classList.add("text-[#1D9BF0]");
          });
          content.addEventListener("mouseout", () => {
            const icon = content.querySelector(".comment-icon").classList.remove("bg-[#1D9BF0]/30");
            const number = content.nextElementSibling.classList.remove("text-[#1D9BF0]");
          });
        });
        const modal = document.getElementById("comment-modal");
        const closeBtn = document.getElementById("close-modal");
        const form = document.getElementById("comment-form");
        document.querySelectorAll(".open-comment-modal").forEach(btn => {
          btn.addEventListener("click", () => {
            const tweetId = btn.getAttribute("data-tweet-id");
            form.setAttribute("action", `/comment/${tweetId}`);
            modal.classList.remove("hidden");
          });
        });
        closeBtn.addEventListener("click", () => {
          modal.classList.add("hidden");
        });
        modal.addEventListener("click", e => {
          if (e.target === modal) {
            modal.classList.add("hidden");
          }
        });
        window.openModal = function() {
          document.getElementById("tweetModal").classList.remove("hidden");
          document.getElementById("tweetModal").classList.add("flex");
        };
        window.closeModal = function() {
          document.getElementById("tweetModal").classList.add("hidden");
          document.getElementById("tweetModal").classList.remove("flex");
        }
      
        window.addEventListener("click", function(e) {
          const modal = document.getElementById("tweetModal");
          if (e.target === modal) {
            closeModal();
          }
        });

        const followBtn = document.querySelectorAll("#follow");
        followBtn.forEach(follow => {
          follow.addEventListener("active", () => {
            follow.classList.add("bg-white/50");
            follow.classList.remove("bg-white");
            follow.classList.remove("hover:bg-white/80");
          });
        });

        document.querySelectorAll(".open-drawer").forEach((btn) => {
          const drawerId = btn.getAttribute("data-drawer-target");
          const drawerPanel = document.querySelector(`.drawer-panel[data-drawer-id="${drawerId}"]`);
          const drawerOverlay = document.querySelector(`.drawer-overlay[data-drawer-id="${drawerId}"]`);
          const closeBtn = drawerPanel?.querySelector(".close-drawer");
    
          if (!drawerPanel || !drawerOverlay) {
            console.warn(`Drawer or overlay with data-drawer-id="${drawerId}" not found`);
            return;
          }
    
          function openDrawer() {
            drawerPanel.classList.remove("-translate-x-full");
            drawerOverlay.classList.remove("opacity-0", "pointer-events-none");
            drawerOverlay.classList.add("opacity-100");
          }
    
          function closeDrawer() {
            drawerPanel.classList.add("-translate-x-full");
            drawerOverlay.classList.add("opacity-0", "pointer-events-none");
            drawerOverlay.classList.remove("opacity-100");
          }
    
          btn.addEventListener("click", openDrawer);
          closeBtn?.addEventListener("click", closeDrawer);
          drawerOverlay.addEventListener("click", closeDrawer);
        });
        const openBtn = document.getElementById("editProfile");
        const modal = document.getElementById("profileModal");
        const closeBtn = document.getElementById("closeModal");

        openBtn.addEventListener("click", () => {
          modal.classList.remove("hidden");
        });

        closeBtn.addEventListener("click", () => {
          modal.classList.add("hidden");
        });

        modal.addEventListener("click", (e) => {
          if (e.target === modal) modal.classList.add("hidden");
        });
      });

     

     
    </script>
  </body>
</html>
